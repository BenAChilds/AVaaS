AVAAS_LISTEN_ADDRESS=:8080
AVAAS_PUBLIC_BASE_URL=http://localhost:8080
AVAAS_DATABASE_PATH=/var/lib/avaas/avaas.db
AVAAS_PEPPER_FILE=/etc/avaas-secrets/api-key.pepper
AVAAS_ENCRYPTION_KEY_FILE=/etc/avaas-secrets/url-encryption.key
AVAAS_SPOOL_DIR=/var/spool/avaas
AVAAS_LOG_DIR=/var/log/avaas
AVAAS_CLAMD_SOCKET=/run/clamav/clamd.sock
AVAAS_MAX_FILE_BYTES=2147483648
AVAAS_QUEUE_LIMIT=1000
AVAAS_WORKER_CONCURRENCY=1
AVAAS_MAX_ATTEMPTS=3
AVAAS_RESULT_RETENTION=24h
AVAAS_DOWNLOAD_TIMEOUT=2h
AVAAS_VALKEY_ENABLED=false
AVAAS_VALKEY_HOST=valkey
AVAAS_VALKEY_PORT=6379
AVAAS_VALKEY_TOPIC=avaas.events
AVAAS_VALKEY_TLS=false
# Official ClamAV containers currently require amd64; Docker Desktop emulates this on Apple Silicon.
CLAMAV_PLATFORM=linux/amd64
