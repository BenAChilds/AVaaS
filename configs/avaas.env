AVAAS_LISTEN_ADDRESS=127.0.0.1:8080
AVAAS_PUBLIC_BASE_URL=http://localhost:8080
AVAAS_DATABASE_PATH=/var/lib/avaas/avaas.db
AVAAS_PEPPER_FILE=/etc/avaas/api-key.pepper
AVAAS_ENCRYPTION_KEY_FILE=/etc/avaas/url-encryption.key
AVAAS_SPOOL_DIR=/var/spool/avaas
AVAAS_LOG_DIR=/var/log/avaas
AVAAS_CLAMD_SOCKET=/run/avaas/clamd.sock
# Optional definition-update relay overrides (defaults shown).
# AVAAS_DEFINITION_UPDATE_TRIGGER=/run/avaas/definition-update.request
# AVAAS_DEFINITION_UPDATE_MIN_INTERVAL=15m
# AVAAS_FRESHCLAM_PID_FILE=/run/avaas/freshclam.pid
AVAAS_MAX_FILE_BYTES=2147483648
AVAAS_QUEUE_LIMIT=1000
AVAAS_WORKER_CONCURRENCY=1
AVAAS_MAX_ATTEMPTS=3
AVAAS_RESULT_RETENTION=24h
AVAAS_DOWNLOAD_TIMEOUT=2h
AVAAS_DOWNLOAD_ALLOWED_PRIVATE_HOSTS=
AVAAS_VALKEY_ENABLED=false
AVAAS_VALKEY_TOPIC=avaas.events
